#!/usr/bin/python3
"""accord-apply — make GTK4, GTK3, and (via qgtk3) Qt apps follow the Omarchy theme.

Reads the active theme's colors.toml and writes @define-color overrides into
~/.config/gtk-4.0/gtk.css and ~/.config/gtk-3.0/gtk.css — the only user-level
lever libadwaita honors — plus the GNOME color-scheme/gtk-theme settings that
Omarchy's installer sets once and never updates on theme switch.

Writes exactly: the two css files (a marked, replaceable block; pre-existing
user css is backed up once and preserved), two gsettings keys (originals saved
for revert), and state.json for the shell plugin. No network, no elevation.

Exit codes: 0 = applied or reverted; 3 = nothing applied (missing or broken
theme input; the reason lands in state.json's lastError and on stderr).

Shebang is /usr/bin/python3 on purpose: `python3` on PATH may be a mise shim
without the system's tomllib environment.
"""

import argparse
import json
import os
import re
import shutil
import subprocess
import sys
import tempfile
import time
import tomllib
from pathlib import Path

HOME = Path.home()


def _env_path(name: str, default: Path) -> Path:
    v = os.environ.get(name)
    return Path(v) if v else default


def _state_default() -> Path:
    # Honor XDG_STATE_HOME like Service.qml and the sibling plugins do.
    base = os.environ.get("XDG_STATE_HOME")
    return (Path(base) if base else HOME / ".local/state") / "omarchy/accord"


THEME_DIR = _env_path("ACCORD_THEME_DIR", HOME / ".local/state/omarchy/current/theme")
GTK4_CSS = _env_path("ACCORD_GTK4_CSS", HOME / ".config/gtk-4.0/gtk.css")
GTK3_CSS = _env_path("ACCORD_GTK3_CSS", HOME / ".config/gtk-3.0/gtk.css")
STATE_DIR = _env_path("ACCORD_STATE_DIR", _state_default())
THEMES_STOCK = _env_path("ACCORD_THEMES_STOCK", Path("/usr/share/omarchy/themes"))
THEMES_USER = _env_path("ACCORD_THEMES_USER", HOME / ".config/omarchy/themes")
STATE_FILE = STATE_DIR / "state.json"
NO_GSETTINGS = os.environ.get("ACCORD_NO_GSETTINGS") == "1"

BEGIN = "/* >>> accord:managed >>> generated from the active Omarchy theme; edits inside this block are overwritten */"
END = "/* <<< accord:managed <<< */"

# GTK4 apps read the user stylesheet only at process startup, so windowless
# daemons keep painting the old palette until restarted. Only these well-known
# D-Bus-activatable apps are ever touched, and never while they own a window.
RESTART_ALLOWLIST = ["nautilus", "geary", "gnome-calendar", "gnome-text-editor",
                     "loupe", "evince", "snapshot"]

HEX_RE = re.compile(r"^#[0-9a-fA-F]{6}$")

# css files are read/written with surrogateescape so a user file with stray
# non-UTF-8 bytes round-trips byte-exact instead of crashing the apply.
ENC = {"encoding": "utf-8", "errors": "surrogateescape"}


def read_file(path: Path) -> str:
    return path.read_text(**ENC)


def atomic_write(path: Path, text: str, enc=None):
    # tmp sibling + replace: a kill mid-write can never truncate the live
    # file. The tmp name is RANDOM and created O_CREAT|O_EXCL|O_NOFOLLOW
    # (mkstemp): a symlink pre-planted at a predictable tmp path would
    # otherwise receive the truncating write. fchmod keeps the customary
    # 0644 the previous default-umask writes had.
    kw = ENC if enc is None else enc
    fd, tmp = tempfile.mkstemp(dir=str(path.parent),
                               prefix=f".{path.name}.", suffix=".accord-tmp")
    try:
        os.fchmod(fd, 0o644)
        with os.fdopen(fd, "w", **kw) as f:
            f.write(text)
        os.replace(tmp, path)
    except BaseException:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        raise


def parse_hex(value):
    if isinstance(value, str) and HEX_RE.match(value.strip()):
        return value.strip().lower()
    return None


def luma(hex_color: str) -> float:
    r, g, b = (int(hex_color[i:i + 2], 16) for i in (1, 3, 5))
    return 0.299 * r + 0.587 * g + 0.114 * b


def on_color(base: str, candidates: list[str]) -> tuple[str, int]:
    """The readable color to draw ON `base`: whichever candidate sits farthest
    away in perceived luma. A naive is-the-accent-dark test fails on light
    themes, where both accent and foreground can sit mid-range."""
    base_l = luma(base)
    best = max(candidates, key=lambda c: abs(luma(c) - base_l))
    return best, round(abs(luma(best) - base_l))


def load_theme(theme_dir: Path):
    toml_path = theme_dir / "colors.toml"
    try:
        with open(toml_path, "rb") as f:
            data = tomllib.load(f)
    except (OSError, tomllib.TOMLDecodeError) as e:
        return None, f"cannot read {toml_path}: {e}"

    def col(*keys):
        for k in keys:
            v = parse_hex(data.get(k))
            if v:
                return v
        return None

    background = col("background")
    foreground = col("foreground")
    accent = col("accent", "blue")
    if not (background and foreground and accent):
        return None, f"{toml_path} lacks background/foreground/accent"

    return {
        "mode": "light" if data.get("mode") == "light" else "dark",
        "background": background,
        "foreground": foreground,
        "accent": accent,
        "dark_background": col("dark_background", "background"),
        "darker_background": col("darker_background", "dark_background", "background"),
        "lighter_background": col("lighter_background", "background"),
        "muted": col("muted", "dark_foreground", "foreground"),
        "selection": col("selection", "lighter_background", "background"),
        "red": col("red", "bright_red") or accent,
        "green": col("green", "bright_green") or accent,
        "yellow": col("yellow", "bright_yellow") or accent,
        "magenta": col("magenta", "bright_magenta") or accent,
        "blue": col("blue", "bright_blue") or accent,
        "cyan": col("cyan", "bright_cyan") or accent,
    }, None


def build_palette(t):
    dark = t["mode"] == "dark"
    if dark:
        window_bg = t["background"]
        view_bg = t["dark_background"]
        headerbar_bg = t["darker_background"]
        surface_bg = t["lighter_background"]     # cards, popovers, dialogs
        sidebar_bg = t["dark_background"]
    else:
        # Light themes invert: the view (content) keeps the lightest tone,
        # chrome around it steps down — the Adwaita-light relationship.
        window_bg = t["dark_background"]
        view_bg = t["background"]
        headerbar_bg = t["darker_background"]
        surface_bg = t["background"]
        sidebar_bg = t["dark_background"]

    fg = t["foreground"]
    on_accent, separation = on_color(t["accent"], [t["background"], t["foreground"]])
    shade = "rgba(0, 0, 0, 0.36)" if dark else "rgba(0, 0, 6, 0.07)"

    return {
        "mode": t["mode"],
        "window_bg": window_bg, "view_bg": view_bg, "headerbar_bg": headerbar_bg,
        "surface_bg": surface_bg, "sidebar_bg": sidebar_bg, "fg": fg,
        "accent": t["accent"], "on_accent": on_accent, "separation": separation,
        "muted": t["muted"], "selection": t["selection"], "shade": shade,
        "red": t["red"], "green": t["green"], "yellow": t["yellow"],
        "on_red": on_color(t["red"], [t["background"], t["foreground"]])[0],
        "on_green": on_color(t["green"], [t["background"], t["foreground"]])[0],
        "on_yellow": on_color(t["yellow"], [t["background"], t["foreground"]])[0],
        "magenta": t["magenta"], "blue": t["blue"], "cyan": t["cyan"],
    }


def gtk4_defines(p):
    return {
        "accent_bg_color": p["accent"], "accent_fg_color": p["on_accent"],
        "accent_color": p["accent"],
        "destructive_bg_color": p["red"], "destructive_fg_color": p["on_red"],
        "destructive_color": p["red"],
        "success_bg_color": p["green"], "success_fg_color": p["on_green"],
        "success_color": p["green"],
        "warning_bg_color": p["yellow"], "warning_fg_color": p["on_yellow"],
        "warning_color": p["yellow"],
        "error_bg_color": p["red"], "error_fg_color": p["on_red"],
        "error_color": p["red"],
        "window_bg_color": p["window_bg"], "window_fg_color": p["fg"],
        "view_bg_color": p["view_bg"], "view_fg_color": p["fg"],
        "headerbar_bg_color": p["headerbar_bg"], "headerbar_fg_color": p["fg"],
        "headerbar_border_color": p["fg"],
        "headerbar_backdrop_color": p["window_bg"],
        "headerbar_shade_color": p["shade"],
        "headerbar_darker_shade_color": p["shade"],
        "sidebar_bg_color": p["sidebar_bg"], "sidebar_fg_color": p["fg"],
        "sidebar_backdrop_color": p["window_bg"],
        "sidebar_shade_color": p["shade"],
        "sidebar_border_color": p["shade"],
        "secondary_sidebar_bg_color": p["sidebar_bg"],
        "secondary_sidebar_fg_color": p["fg"],
        "secondary_sidebar_backdrop_color": p["window_bg"],
        "secondary_sidebar_shade_color": p["shade"],
        "secondary_sidebar_border_color": p["shade"],
        "card_bg_color": p["surface_bg"], "card_fg_color": p["fg"],
        "card_shade_color": p["shade"],
        "dialog_bg_color": p["surface_bg"], "dialog_fg_color": p["fg"],
        "popover_bg_color": p["surface_bg"], "popover_fg_color": p["fg"],
        "popover_shade_color": p["shade"],
        "thumbnail_bg_color": p["surface_bg"], "thumbnail_fg_color": p["fg"],
        "shade_color": p["shade"],
        "scrollbar_outline_color": p["shade"],
    }


def gtk3_defines(p):
    return {
        "theme_bg_color": p["window_bg"], "theme_fg_color": p["fg"],
        "theme_base_color": p["view_bg"], "theme_text_color": p["fg"],
        "theme_selected_bg_color": p["accent"], "theme_selected_fg_color": p["on_accent"],
        "theme_unfocused_bg_color": p["window_bg"], "theme_unfocused_fg_color": p["fg"],
        "theme_unfocused_base_color": p["view_bg"], "theme_unfocused_text_color": p["fg"],
        "theme_unfocused_selected_bg_color": p["accent"],
        "theme_unfocused_selected_fg_color": p["on_accent"],
        "insensitive_bg_color": p["window_bg"], "insensitive_fg_color": p["muted"],
        "insensitive_base_color": p["view_bg"],
        "borders": p["selection"], "unfocused_borders": p["selection"],
        "link_color": p["accent"], "link_visited_color": p["magenta"],
        "success_color": p["green"], "warning_color": p["yellow"], "error_color": p["red"],
    }


def render_block(defines: dict) -> str:
    lines = [BEGIN]
    lines += [f"@define-color {name} {value};" for name, value in defines.items()]
    lines.append(END)
    return "\n".join(lines) + "\n"


def find_block_span(text: str):
    """Span of the managed region, tolerant of a truncated END: a file whose
    write was cut off after BEGIN would otherwise grow a second block, and GTK
    resolves duplicate @define-color names last-wins — a silent stale palette.
    From BEGIN to END inclusive when END follows; to end-of-file when it
    doesn't (the truncation ate our block, and whatever followed it)."""
    b = text.find(BEGIN)
    if b < 0:
        return None
    e = text.find(END, b)
    if e < 0:
        return b, len(text)
    e += len(END)
    if e < len(text) and text[e] == "\n":
        e += 1
    return b, e


def strip_block(text: str) -> str:
    span = find_block_span(text)
    if span is None:
        return text
    remainder = text[:span[0]] + text[span[1]:]
    # write_managed joins block and user content with one extra newline.
    if remainder.startswith("\n"):
        remainder = remainder[1:]
    return remainder


def write_managed(path: Path, block: str) -> str:
    """Install `block` as the accord-managed region of `path`.
    Returns created | updated | unchanged | merged."""
    # Operate on the real file so a symlinked gtk.css (dotfiles setups) keeps
    # its link and the backup sits next to the target, not the link.
    path.parent.mkdir(parents=True, exist_ok=True)
    path = path.resolve() if path.exists() else path.parent.resolve() / path.name

    if not path.exists():
        atomic_write(path, block)
        return "created"

    text = read_file(path)
    span = find_block_span(text)
    if span is not None:
        new = text[:span[0]] + block + text[span[1]:]
        if new == text:
            return "unchanged"
        atomic_write(path, new)
        return "updated"

    # Someone else's css: keep every byte, once, in a backup we can restore,
    # and put our block FIRST so later user rules win on any conflict.
    backup = path.with_name(path.name + ".accord-backup")
    if not backup.exists():
        shutil.copy2(path, backup)
    atomic_write(path, block + "\n" + text)
    return "merged"


def revert_file(path: Path):
    if path.exists():
        path = path.resolve()
    backup = path.with_name(path.name + ".accord-backup")

    if backup.exists():
        backup_text = read_file(backup)
        if path.exists():
            remainder = strip_block(read_file(path))
            if remainder != backup_text:
                # The user edited the file after we merged: keep their newer
                # content (minus our block) and leave the backup as reference.
                atomic_write(path, remainder)
                return "stripped-kept-backup"
        atomic_write(path, backup_text)
        backup.unlink()
        return "restored-backup"

    if not path.exists():
        return "absent"
    text = read_file(path)
    if BEGIN not in text:
        return "untouched"
    remainder = strip_block(text)
    if remainder.strip() == "":
        path.unlink()
        return "removed"
    atomic_write(path, remainder)
    return "stripped"


def gsettings_get(key: str):
    try:
        out = subprocess.run(
            ["gsettings", "get", "org.gnome.desktop.interface", key],
            capture_output=True, text=True, timeout=10)
        return out.stdout.strip().strip("'") if out.returncode == 0 else None
    except (OSError, subprocess.TimeoutExpired):
        return None


def gsettings_set(key: str, value: str) -> bool:
    try:
        return subprocess.run(
            ["gsettings", "set", "org.gnome.desktop.interface", key, value],
            capture_output=True, timeout=10).returncode == 0
    except (OSError, subprocess.TimeoutExpired):
        return False


def display_name(theme_dir: Path) -> str:
    """omarchy 4 keeps current/theme as a real directory (its contents are
    copied on switch) with the human name in a theme.name sibling; a plain
    theme directory just uses its own name."""
    try:
        name = (theme_dir.parent / "theme.name").read_text(encoding="utf-8").strip()
    except OSError:
        name = ""
    if not name:
        name = theme_dir.resolve().name
    return re.sub(r"[^A-Za-z0-9 _.-]", "-", name)[:64]


def load_state():
    try:
        with open(STATE_FILE, encoding="utf-8") as f:
            return json.load(f)
    except (OSError, json.JSONDecodeError):
        return {}


def save_state(state: dict):
    try:
        STATE_DIR.mkdir(parents=True, exist_ok=True)
        atomic_write(STATE_FILE, json.dumps(state, indent=1) + "\n",
                     enc={"encoding": "utf-8"})
        return True
    except OSError as e:
        print(f"accord: cannot write {STATE_FILE}: {e}", file=sys.stderr)
        return False


def usable_saved(saved) -> bool:
    # A dict of Nones means the capture ran while gsettings was unreachable;
    # treating it as settled would silently break --revert forever.
    return isinstance(saved, dict) and any(saved.values())


def windowed_pids():
    """PIDs owning a visible Hyprland window, or None if that cannot be known."""
    try:
        out = subprocess.run(["hyprctl", "clients", "-j"],
                             capture_output=True, text=True, timeout=10)
        if out.returncode != 0:
            return None
        return {c["pid"] for c in json.loads(out.stdout)
                if isinstance(c, dict) and c.get("pid")}
    except (OSError, subprocess.TimeoutExpired, json.JSONDecodeError,
            TypeError, AttributeError, KeyError):
        return None


def running_pids(name: str) -> list[int]:
    # Scoped to this user: without -U, pgrep would report (and this tool would
    # claim to have restarted) other users' processes it cannot signal.
    try:
        out = subprocess.run(["pgrep", "-x", "-U", str(os.getuid()), name],
                             capture_output=True, text=True, timeout=10)
    except (OSError, subprocess.TimeoutExpired):
        return []
    if out.returncode != 0:
        return []
    return [int(p) for p in out.stdout.split() if p.isdigit()]


def restart_apps():
    """SIGTERM allowlisted GTK daemons so they relaunch with the new palette.
    An app with an open window is never killed — it repaints on next launch."""
    candidates = {name: pids for name in RESTART_ALLOWLIST
                  if (pids := running_pids(name))}
    if not candidates:
        return [], []

    # Snapshot windows AFTER collecting pids, immediately before the kills,
    # to shrink the race where an app opens its first window mid-scan. A pid
    # reused in the remaining milliseconds is the ceiling of this approach.
    visible = windowed_pids()
    if visible is None:
        # Can't tell windowed from windowless: restarting blind could close
        # something the user is looking at. Report only apps actually running.
        return [], sorted(candidates)

    restarted, pending = [], []
    for name, pids in candidates.items():
        if any(p in visible for p in pids):
            pending.append(name)
            continue
        for p in pids:
            try:
                os.kill(p, 15)
            except OSError:
                pass
        restarted.append(name)
    return restarted, pending


def catalog_themes() -> int:
    """Write themes.json: every installed theme rendered down to the palette
    the fitting-room cards paint with. User themes shadow stock ones by id."""
    entries = {}
    for base in (THEMES_STOCK, THEMES_USER):
        if not base.is_dir():
            continue
        for d in sorted(base.iterdir()):
            if not (d / "colors.toml").is_file():
                continue
            theme, err = load_theme(d)
            if theme is None:
                print(f"accord: skipping theme {d.name}: {err}", file=sys.stderr)
                continue
            p = build_palette(theme)
            entries[d.name] = {
                "id": d.name,
                "name": d.name.replace("-", " ").title(),
                "mode": p["mode"],
                "source": "user" if base == THEMES_USER else "stock",
                "palette": {
                    "window_bg": p["window_bg"], "view_bg": p["view_bg"],
                    "headerbar_bg": p["headerbar_bg"], "surface_bg": p["surface_bg"],
                    "sidebar_bg": p["sidebar_bg"], "fg": p["fg"], "muted": p["muted"],
                    "accent": p["accent"], "on_accent": p["on_accent"],
                    "red": p["red"], "green": p["green"], "yellow": p["yellow"],
                },
            }
    current = ""
    try:
        current = (THEME_DIR.parent / "theme.name").read_text(encoding="utf-8").strip()
        current = re.sub(r"[^a-z0-9]+", "-", current.lower()).strip("-")
    except OSError:
        pass
    out = {"schemaVersion": 1, "generatedAt": int(time.time()),
           "current": current, "themes": list(entries.values())}
    try:
        STATE_DIR.mkdir(parents=True, exist_ok=True)
        atomic_write(STATE_DIR / "themes.json",
                     json.dumps(out, indent=1) + "\n",
                     enc={"encoding": "utf-8"})
    except OSError as e:
        print(f"accord: cannot write themes.json: {e}", file=sys.stderr)
        return 3
    print(f"accord: cataloged {len(entries)} themes"
          + (f", current {current}" if current else ""))
    return 0


def do_revert() -> int:
    state = load_state()
    r4 = revert_file(GTK4_CSS)
    r3 = revert_file(GTK3_CSS)
    saved = state.get("gsettings", {}).get("saved") or {}
    restored, failed = [], []
    if not NO_GSETTINGS:
        # Prefer handing the keys back to Omarchy itself: theme-set-gnome
        # recomputes mode-correct values for the CURRENT theme, which beats
        # restoring a snapshot that may predate several theme switches.
        handed_back = False
        if shutil.which("omarchy-theme-set-gnome"):
            try:
                handed_back = subprocess.run(["omarchy-theme-set-gnome"],
                                             capture_output=True, timeout=15).returncode == 0
            except (OSError, subprocess.TimeoutExpired):
                handed_back = False
        if handed_back:
            restored = ["via omarchy-theme-set-gnome"]
        else:
            for key, value in saved.items():
                if not value:
                    continue
                (restored if gsettings_set(key, value) else failed).append(key)
    if failed:
        # Keep state.json so the saved originals survive for a retry.
        print(f"accord: reverted css (gtk4: {r4}, gtk3: {r3}) but could not "
              f"restore gsettings: {', '.join(failed)} - state kept for retry",
              file=sys.stderr)
        return 0
    STATE_FILE.unlink(missing_ok=True)
    gs = ", ".join(restored) if restored else "nothing to restore"
    print(f"accord: reverted (gtk4: {r4}, gtk3: {r3}, gsettings: {gs})")
    return 0


def main():
    ap = argparse.ArgumentParser(description=__doc__)
    ap.add_argument("--no-restart", action="store_true",
                    help="do not restart windowless GTK daemons")
    ap.add_argument("--revert", action="store_true",
                    help="remove everything accord wrote and restore saved settings")
    ap.add_argument("--themes", action="store_true",
                    help="write themes.json - the catalog the fitting room browses")
    args = ap.parse_args()

    if args.revert:
        return do_revert()
    if args.themes:
        return catalog_themes()

    theme, err = load_theme(THEME_DIR)
    if theme is None:
        print(f"accord: {err}; nothing applied", file=sys.stderr)
        # Leave a durable trace so the panel can say WHY instead of showing
        # yesterday's palette as if it were current.
        prev = load_state() or {"schemaVersion": 1}
        prev["lastError"] = err
        prev["lastErrorAt"] = int(time.time())
        save_state(prev)
        return 3

    p = build_palette(theme)
    theme_name = display_name(THEME_DIR)

    prev = load_state()
    gsettings = {"applied": False,
                 "saved": prev.get("gsettings", {}).get("saved")}
    if not NO_GSETTINGS and not usable_saved(gsettings["saved"]):
        captured = {"color-scheme": gsettings_get("color-scheme"),
                    "gtk-theme": gsettings_get("gtk-theme")}
        # Persist only a real capture; a failed one retries on the next run.
        gsettings["saved"] = captured if usable_saved(captured) else None
        if gsettings["saved"]:
            # Save the originals BEFORE the first set: a crash in between must
            # not make accord's own values the "originals" revert restores.
            early = dict(prev) if prev else {"schemaVersion": 1}
            early["gsettings"] = {"applied": False, "saved": gsettings["saved"]}
            save_state(early)

    s4 = write_managed(GTK4_CSS, render_block(gtk4_defines(p)))
    s3 = write_managed(GTK3_CSS, render_block(gtk3_defines(p)))

    if not NO_GSETTINGS:
        scheme = "prefer-light" if p["mode"] == "light" else "prefer-dark"
        gtk_theme = "Adwaita" if p["mode"] == "light" else "Adwaita-dark"
        ok1 = gsettings_set("color-scheme", scheme)
        ok2 = gsettings_set("gtk-theme", gtk_theme)
        gsettings.update({"applied": ok1 and ok2,
                          "color_scheme": scheme, "gtk_theme": gtk_theme})

    restarted, pending = ([], [])
    if not args.no_restart and s4 in ("created", "updated", "merged"):
        restarted, pending = restart_apps()

    state = {
        "schemaVersion": 1,
        "generatedAt": int(time.time()),
        "generatedAtIso": time.strftime("%Y-%m-%dT%H:%M:%S%z"),
        "theme": theme_name,
        "mode": p["mode"],
        "palette": {
            "window_bg": p["window_bg"], "view_bg": p["view_bg"],
            "headerbar_bg": p["headerbar_bg"], "surface_bg": p["surface_bg"],
            "sidebar_bg": p["sidebar_bg"], "fg": p["fg"],
            "accent": p["accent"], "on_accent": p["on_accent"],
            "separation": p["separation"], "muted": p["muted"],
            "red": p["red"], "green": p["green"], "yellow": p["yellow"],
            "blue": p["blue"], "cyan": p["cyan"], "magenta": p["magenta"],
        },
        "files": {
            "gtk4": {"path": str(GTK4_CSS), "status": s4},
            "gtk3": {"path": str(GTK3_CSS), "status": s3},
        },
        "gsettings": gsettings,
        "restarts": {"restarted": restarted, "pending": pending},
    }
    save_state(state)

    print(f"accord: {theme_name} ({p['mode']}) → gtk4 {s4}, gtk3 {s3}"
          + (f", restarted {','.join(restarted)}" if restarted else "")
          + (f", pending {','.join(pending)}" if pending else ""))
    return 0


if __name__ == "__main__":
    sys.exit(main())
